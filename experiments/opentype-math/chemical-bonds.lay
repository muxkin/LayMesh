# Native chemical-bond geometry in different math styles. No adjusted formula sources.
page=canvas(size=(400mm,260mm),background="#ffffff",font_family="../../tests/fonts/DejaVuSans.ttf")
page.add(text("Chemical bond geometry",font_size=20pt),offset=(5mm,4mm))
