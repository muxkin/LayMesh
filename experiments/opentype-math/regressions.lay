# Enlarged regressions for chemical bonds and nested math alphabet commands.
page=canvas(size=(400mm,190mm),background="#ffffff",font_family="../../tests/fonts/DejaVuSans.ttf")
page.add(text("Chemical bonds and math alphabets",font_size=20pt),offset=(5mm,4mm))
page.add(text("KaTeX",font_size=12pt),offset=(5mm,17mm))
page.add(text("Partial double bond",font_size=9pt,color="#687385"),offset=(5mm,30mm))
page.add(formula(r"""\ce{A\bond{~-}B}""",math_font="ratex-katex",font_size=22pt,style=display),offset=(5mm,35mm))
page.add(text("Partial triple bonds",font_size=9pt,color="#687385"),offset=(5mm,51mm))
page.add(formula(r"""\ce{A\bond{~--}B\bond{~=}C}""",math_font="ratex-katex",font_size=22pt,style=display),offset=(5mm,56mm))
page.add(text("Mixed triple bond",font_size=9pt,color="#687385"),offset=(5mm,72mm))
