{
  "name": "laymesh-language",
  "displayName": "LayMesh",
  "version": "0.3.9",
  "publisher": "Hyacine",
  "description": "%extension.description%",
  "icon": "icon.png",
  "keywords": [
    "LayMesh",
    "LCSS",
    "scientific figures",
    "plot",
    "preview",
    "rulers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/muxkin/LayMesh.git"
  },
  "homepage": "https://muxkin.github.io/LayMesh/",
  "bugs": {
    "url": "https://github.com/muxkin/LayMesh/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/client.cjs",
  "activationEvents": [
    "onLanguage:laymesh",
    "onLanguage:lcss"
  ],
  "contributes": {
    "languages": [
      {
        "id": "laymesh",
        "aliases": [
          "LayMesh"
        ],
        "extensions": [
          ".lay"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lcss",
        "aliases": [
          "LCSS"
        ],
        "extensions": [
          ".lcss"
        ],
        "configuration": "./lcss-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "laymesh",
        "scopeName": "source.laymesh",
        "path": "./syntaxes/laymesh.tmLanguage.json"
      },
      {
        "language": "lcss",
        "scopeName": "source.lcss",
        "path": "./syntaxes/lcss.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "LayMesh",
      "properties": {
        "laymesh.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "scope": "window",
          "markdownDescription": "%config.language%",
          "enumDescriptions": [
            "%language.auto%",
            "%language.zh-CN%",
            "%language.en%"
          ]
        },
        "laymesh.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.executable%"
        },
        "laymesh.preview.debounceMs": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 5000,
          "description": "%config.preview.debounceMs%"
        },
        "laymesh.preview.renderTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 100,
          "maximum": 300000,
          "description": "%config.preview.renderTimeoutMs%"
        },
        "laymesh.preview.showRulers": {
          "type": "boolean",
          "default": true,
          "description": "%config.preview.showRulers%"
        },
        "laymesh.export.dpi": {
          "type": "number",
          "default": 1200,
          "minimum": 0.01,
          "maximum": 25400,
          "description": "%config.export.dpi%"
        },
        "laymesh.export.quality": {
          "type": "integer",
          "default": 90,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.export.quality%"
        },
        "laymesh.export.tiffCompression": {
          "type": "string",
          "default": "lzw",
          "enum": [
            "none",
            "lzw",
            "deflate",
            "packbits"
          ],
          "description": "%config.export.tiffCompression%"
        },
        "laymesh.export.webpLossless": {
          "type": "boolean",
          "default": true,
          "description": "%config.export.webpLossless%"
        },
        "laymesh.export.pdf.imageCompression": {
          "type": "string",
          "default": "auto",
          "description": "%config.export.pdf.imageCompression%",
          "enum": [
            "auto",
            "lossless",
            "jpeg"
          ]
        },
        "laymesh.export.pdf.jpegQuality": {
          "type": "integer",
          "default": 90,
          "description": "%config.export.pdf.jpegQuality%",
          "minimum": 1,
          "maximum": 100
        },
        "laymesh.export.pdf.downsample": {
          "type": "boolean",
          "default": true,
          "description": "%config.export.pdf.downsample%"
        },
        "laymesh.export.pdf.recompressJpeg": {
          "type": "boolean",
          "default": false,
          "description": "%config.export.pdf.recompressJpeg%"
        },
        "laymesh.export.pdf.autoPaletteLimit": {
          "type": "integer",
          "default": 32,
          "description": "%config.export.pdf.autoPaletteLimit%",
          "minimum": 0,
          "maximum": 16384
        },
        "laymesh.export.pdf.autoFlatnessThreshold": {
          "type": "number",
          "default": 0.9,
          "description": "%config.export.pdf.autoFlatnessThreshold%",
          "minimum": 0,
          "maximum": 1
        },
        "laymesh.preview.jpegQuality": {
          "type": "integer",
          "default": 90,
          "description": "%config.preview.jpegQuality%",
          "minimum": 1,
          "maximum": 100
        },
        "laymesh.preview.cacheMb": {
          "type": "integer",
          "default": 256,
          "description": "%config.preview.cacheMb%",
          "minimum": 1,
          "maximum": 65536
        },
        "laymesh.export.pdf.preserve16bit": {
          "type": "boolean",
          "default": true,
          "description": "%config.export.pdf.preserve16bit%"
        },
        "laymesh.export.pdf.preserveAlpha": {
          "type": "boolean",
          "default": true,
          "description": "%config.export.pdf.preserveAlpha%"
        },
        "laymesh.export.pdf.alphaBackground": {
          "type": "string",
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "%config.export.pdf.alphaBackground%"
        },
        "laymesh.preview.webpQuality": {
          "type": "integer",
          "default": 90,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.preview.webpQuality%"
        },
        "laymesh.preview.webpMethod": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 6,
          "description": "%config.preview.webpMethod%"
        },
        "laymesh.preview.imageThreads": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "%config.preview.imageThreads%"
        },
        "laymesh.preview.processingMemoryMb": {
          "type": "integer",
          "default": 128,
          "minimum": 1,
          "maximum": 65536,
          "description": "%config.preview.processingMemoryMb%"
        },
        "laymesh.export.pngCompression": {
          "type": "string",
          "default": "default",
          "enum": [
            "fast",
            "default",
            "best"
          ],
          "description": "%config.export.pngCompression%"
        },
        "laymesh.export.background": {
          "type": "string",
          "default": "#ffffff",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "%config.export.background%"
        },
        "laymesh.export.webpMethod": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 6,
          "description": "%config.export.webpMethod%"
        },
        "laymesh.export.webpAlphaQuality": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.export.webpAlphaQuality%"
        },
        "laymesh.export.webpNearLossless": {
          "type": "integer",
          "default": 100,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.export.webpNearLossless%"
        },
        "laymesh.export.webpQuality": {
          "type": "integer",
          "default": 90,
          "minimum": 0,
          "maximum": 100,
          "description": "%config.export.webpQuality%"
        }
      }
    },
    "commands": [
      {
        "command": "laymesh.editColor",
        "title": "%command.editColor%"
      },
      {
        "command": "laymesh.openPreview",
        "title": "%command.openPreview%",
        "icon": "$(preview)"
      },
      {
        "command": "laymesh.exportFigure",
        "title": "%command.exportFigure%",
        "icon": "$(export)"
      },
      {
        "command": "laymesh.configurePreviewDebounce",
        "title": "%command.configurePreviewDebounce%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "laymesh.editColor",
          "when": "editorLangId == laymesh || editorLangId == lcss",
          "group": "navigation"
        },
        {
          "command": "laymesh.openPreview",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "laymesh.exportFigure",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "laymesh.openPreview",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "laymesh.exportFigure",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capability.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "laymesh.executable"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capability.virtualWorkspaces%"
    }
  }
}
