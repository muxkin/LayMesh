{
  "name": "laymesh-language",
  "displayName": "LayMesh",
  "version": "0.3.6",
  "publisher": "Hyacine",
  "description": "%extension.description%",
  "preview": true,
  "icon": "icon.png",
  "keywords": [
    "LayMesh",
    "LCSS",
    "scientific figures",
    "plot",
    "preview",
    "rulers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/muxkin/LayMesh.git"
  },
  "homepage": "https://muxkin.github.io/LayMesh/",
  "bugs": {
    "url": "https://github.com/muxkin/LayMesh/issues"
  },
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "license": "MIT",
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/client.cjs",
  "activationEvents": [
    "onLanguage:laymesh",
    "onLanguage:lcss"
  ],
  "contributes": {
    "languages": [
      {
        "id": "laymesh",
        "aliases": [
          "LayMesh"
        ],
        "extensions": [
          ".lay"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lcss",
        "aliases": [
          "LCSS"
        ],
        "extensions": [
          ".lcss"
        ],
        "configuration": "./lcss-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "laymesh",
        "scopeName": "source.laymesh",
        "path": "./syntaxes/laymesh.tmLanguage.json"
      },
      {
        "language": "lcss",
        "scopeName": "source.lcss",
        "path": "./syntaxes/lcss.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "LayMesh",
      "properties": {
        "laymesh.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "default": "auto",
          "scope": "window",
          "markdownDescription": "%config.language%",
          "enumDescriptions": [
            "%language.auto%",
            "%language.zh-CN%",
            "%language.en%"
          ]
        },
        "laymesh.executable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.executable%"
        },
        "laymesh.preview.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 5000,
          "description": "%config.preview.debounceMs%"
        },
        "laymesh.preview.renderTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 100,
          "maximum": 300000,
          "description": "%config.preview.renderTimeoutMs%"
        },
        "laymesh.preview.showRulers": {
          "type": "boolean",
          "default": true,
          "description": "%config.preview.showRulers%"
        },
        "laymesh.export.dpi": {
          "type": "number",
          "default": 300,
          "minimum": 0.01,
          "maximum": 25400,
          "description": "%config.export.dpi%"
        },
        "laymesh.export.quality": {
          "type": "integer",
          "default": 90,
          "minimum": 1,
          "maximum": 100,
          "description": "%config.export.quality%"
        },
        "laymesh.export.tiffCompression": {
          "type": "string",
          "default": "lzw",
          "enum": [
            "none",
            "lzw",
            "deflate",
            "packbits"
          ],
          "description": "%config.export.tiffCompression%"
        },
        "laymesh.export.webpLossless": {
          "type": "boolean",
          "default": true,
          "description": "%config.export.webpLossless%"
        }
      }
    },
    "commands": [
      {
        "command": "laymesh.editColor",
        "title": "%command.editColor%"
      },
      {
        "command": "laymesh.openPreview",
        "title": "%command.openPreview%",
        "icon": "$(preview)"
      },
      {
        "command": "laymesh.exportFigure",
        "title": "%command.exportFigure%",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "laymesh.editColor",
          "when": "editorLangId == laymesh || editorLangId == lcss",
          "group": "navigation"
        },
        {
          "command": "laymesh.openPreview",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "laymesh.exportFigure",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "laymesh.openPreview",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        },
        {
          "command": "laymesh.exportFigure",
          "when": "editorLangId == laymesh && resourceScheme == file && isWorkspaceTrusted",
          "group": "navigation"
        }
      ]
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capability.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "laymesh.executable"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capability.virtualWorkspaces%"
    }
  }
}
