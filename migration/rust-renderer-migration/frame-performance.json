    "effect_cache_maximum_entries": 128,
    "effect_frame_pixel_budget": 100000000,
    "effect_budget_counts_nested_effects_on_cache_hits": true,
    "vscode_worker": "Bundled blob module with explicit packaged WASM URL; install, decode and raster work stays off the UI thread",
    "pan_overscan_css_px": 96,
    "zoom_settle_ms": 80,
    "paint_queue": "One in flight and latest pending; obsolete generations acknowledge; returning to an already covered viewport cancels stale requests",
    "overview": "At most 500000 pixels, generated only when needed or downsampled from the existing full-page paint; clipped out beneath the sharp patch to preserve Alpha; final viewport is covered by DPR pixels",
    "internal_svg_fallback": false
