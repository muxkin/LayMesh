page = canvas(size=(220 mm, 68 mm), background="#ffffff")
style = plot_style(font_family="DejaVu Sans", font_size=9 pt)
# BEGIN DEMO
p = plot(size=(210 mm, 58 mm), plot_area=box(offset=(18 mm, 6 mm), size=(185 mm, 39 mm)),
         x=axis(label="Time (s)", range=(-0.15, 3.15), ticks=[0, 1, 2, 3]),
         y=axis(label="Signal", range=(0, 5)), style=style)
p.line(x=[0, 1, 2, 3], y=[1, 3, 2, 4], color="#1683e8", label="Experiment")
p.scatter(x=[0, 1, 2, 3], y=[1, 3, 2, 4], color="#1683e8", marker_size=2.4 mm)
p.legend(position= top_left)
page.add(p, offset=(5 mm, 5 mm))
# END DEMO
