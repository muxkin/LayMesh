# CLI quality fixture: native geometry, strokes, rounded pictures and gradients.
page=canvas(size=(180mm,120mm),background="#ffffff")
page.add(text("原生形状 / Native objects",font_family="Noto Sans CJK SC",font_size=18pt,font_weight=700),offset=(8mm,6mm))
inner=group()
inner.add(rect(size=(28mm,18mm),border_radius=4mm,fill="#e6f0ff",border_color="#1268ff",border_width=0.6mm))
inner.add(ellipse(size=(12mm,8mm),fill="#20386480",border_width=0),offset=(35mm,5mm))
outer=group()
outer.add(inner)
page.add(outer,offset=(10mm,24mm),rotation=-12deg)
page.add(line(dx=45mm,dy=8mm,line_width=0.6mm,line_color="#1268ff",line_dash=[3mm,1.5mm],line_cap=round,start_cap=round,end_cap=round),offset=(70mm,30mm))
page.add(formula(source=r"\frac{x^2+1}{3}",font_size=18pt),offset=(133mm,25mm))
# The same independent PNG is shared by three fills and one cropped picture.
page.add(rect(size=(32mm,20mm),border_radius=3mm,fill=image_fill(src="../gallery/assets/sample.png",fit=cover),border_width=0),offset=(10mm,54mm))
page.add(rect(size=(32mm,20mm),border_radius=3mm,fill=image_fill(src="../gallery/assets/sample.png",fit=contain),border_width=0),offset=(50mm,54mm))
page.add(rect(size=(32mm,20mm),border_radius=3mm,fill=image_fill(src="../gallery/assets/sample.png",fit=stretch),border_width=0),offset=(90mm,54mm),rotation=12deg,opacity=0.7)
page.add(image(src="../gallery/assets/sample.png"),fit=cover,size=(28mm,20mm),crop=box(offset=(0.25,0),size=(0.5,1)),offset=(135mm,54mm))
page.add(rect(size=(60mm,20mm),fill=linear_gradient(start=(0.15,0.2),end=(0.85,0.8),stops=[(0,"#ff774480"),(1,"#1268ff80")]),border_width=0),offset=(10mm,88mm),rotation=5deg)
page.add(rect(size=(40mm,20mm),fill=linear_gradient(stops=[(0,"#fff00000"),(1,"#1268ff")]),border_width=0),offset=(90mm,88mm))
