# Gallery: containers / module-import
import { card } from "./card-component.lay"
page = canvas(name="Imported component", size=(120 mm, 80 mm), background="#f7f9fc")
font = "DejaVu Sans"
heading = text(content="Imported component", font_family=font, font_size=14 pt, color="#203864")
page.add(heading, target=page.top_left, offset=(7 mm, 5 mm))
# BEGIN DEMO
first = page.add(card("A"), target=page.top_left, offset=(8 mm, 29 mm))
page.add(card("B"), target=first.top_right, offset=(13 mm, 0 mm))
# END DEMO
