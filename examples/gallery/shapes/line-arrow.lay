# Gallery: shapes / line-arrow
page = canvas(name="Lines and arrows", size=(120 mm, 80 mm), background="#f7f9fc")
font = "DejaVu Sans"
heading = text(content="Lines and arrows", font_family=font, font_size=14 pt, color="#203864")
page.add(heading, target=page.top_left, offset=(7 mm, 5 mm))
# BEGIN DEMO
page.add(line(dx=55 mm, dy=0 mm, line_color="#087f8c", line_width=1.2 mm),
         target=page.top_left, offset=(18 mm, 34 mm))
page.add(line(end_head=head(), dx=55 mm, dy=13 mm, line_color="#e67563", line_width=1.2 mm),
         target=page.top_left, offset=(18 mm, 48 mm))
# END DEMO
