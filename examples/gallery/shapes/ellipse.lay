# Gallery: shapes / ellipse
page = canvas(name="Ellipse", size=(120 mm, 80 mm), background="#f7f9fc")
font = "DejaVu Sans"
heading = text(content="Ellipse", font_family=font, font_size=14 pt, color="#203864")
page.add(heading, target=page.top_left, offset=(7 mm, 5 mm))
# BEGIN DEMO
oval = ellipse(size=(68 mm, 38 mm), fill="#f3be6b",
               border_color="#a66435", border_width=0.8 mm)
page.add(oval, target=page.top_left, offset=(25 mm, 28 mm))
# END DEMO
