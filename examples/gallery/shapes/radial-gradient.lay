# Gallery: shapes / radial-gradient
page = canvas(name="Radial gradient", size=(120 mm, 80 mm), background="#f7f9fc")
font = "DejaVu Sans"
heading = text(content="Radial gradient", font_family=font, font_size=14 pt, color="#203864")
page.add(heading, target=page.top_left, offset=(7 mm, 5 mm))
# BEGIN DEMO
paint = radial_gradient(center=(0.37, 0.3), radius=0.8,
                        stops=[(0, "#d8fff7"), (1, "#087f8c")])
page.add(ellipse(size=(54 mm, 43 mm), fill=paint),
         target=page.top_left, offset=(33 mm, 27 mm))
# END DEMO
