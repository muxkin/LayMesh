# Gallery: shapes / rect
page = canvas(name="Rounded rectangle", size=(120 mm, 80 mm), background="#f7f9fc")
font = "DejaVu Sans"
heading = text(content="Rounded rectangle", font_family=font, font_size=14 pt, color="#203864")
page.add(heading, target=page.top_left, offset=(7 mm, 5 mm))
# BEGIN DEMO
tile = rect(size=(61 mm, 37 mm), border_radius=6 mm, fill="#d8f0ec",
            border_color="#087f8c", border_width=1 mm)
page.add(tile, target=page.top_left, offset=(28 mm, 28 mm))
# END DEMO
