page=canvas(size=(200mm,120mm),background="#182536")
style { text {font-family:"DejaVu Sans";font-size:10pt;color:#e4edf8;} }
page.add(text("Shape styles & effects",font_size=23pt,font_weight=700),offset=(10,8))
page.add(text("Gradient + shadow"),offset=(12,30))
page.add(arrow(length=74,shaft_width=(5,10),head_size=(17,22),fill=linear_gradient(start=(0,0),end=(1,0),stops=[(0,"#69d5ca"),(1,"#438deb")]),border_color="#ffffff",border_width=0.5mm,effects=[shadow(blur=1.3mm,offset=(1.5mm,2mm),opacity=0.7)]),offset=(12,43))
page.add(text("One outline + 50% opacity"),offset=(12,85))
page.add(arrow(length=74,shaft_width=5,heads=both,head_size=(12,14),fill="#fda777",border_color="#ffffff",border_width=0.6mm),offset=(12,96),opacity=0.5)
page.add(text("Glow / inner shadow"),offset=(108,30))
page.add(arrow.arc(radius=24,start_angle=145deg,sweep_angle=260deg,shaft_width=(4,7),head_size=(10,15),fill="#98bbfa",border_color="#ffffff",border_width=0.5mm,effects=[glow(color="#57bcff",blur=1.5mm,opacity=0.6),shadow(mode="inner",blur=0.8mm,offset=(1mm,1mm))]),offset=(116,43))
