p = canvas(size=(160mm,122mm),background="#eef1f5")
p.add(text("Independent video controls",font_size=5mm),offset=(10mm,4mm))
automatic = p.add(video(src="controls.mp4"),size=(64mm,36mm),offset=(10mm,16mm))
click_video = p.add(video(src="controls.mp4"),size=(64mm,36mm),offset=(86mm,16mm))
step_video = p.add(video(src="controls.mp4"),size=(64mm,36mm),offset=(10mm,74mm))
manual = p.add(video(src="controls.mp4"),size=(64mm,36mm),offset=(86mm,74mm))
p.add(text("Page start + independent controls",font_size=3mm),offset=(10mm,55mm))
p.add(text("Click start, trimmed 2-10 seconds",font_size=3mm),offset=(86mm,55mm))
p.add(text("Step start + independent controls",font_size=3mm),offset=(10mm,113mm))
p.add(text("Manual, without a play binding",font_size=3mm),offset=(86mm,113mm))
p.play(automatic)
p.play(click_video,trigger="click",trim_start=2s,trim_end=10s,export_start=1s)
s = p.step(duration=12s,hold=0s)
s.play(step_video,delay=200ms,trim_start=1s,trim_end=9s)
