page=canvas(size=(100mm,100mm),stylesheet="@laymesh/animate.css",background="#f6f7fb")
style {
rect {background-color:#0d6efd;border:1px solid #20332f}
text {background-color:#e9ecef;color:#212529;border:1px solid #adb5bd}

}
item=page.add(rect(size=(40mm,25mm),class="animate__animated animate__fadeInUp"),anchor=center,target=page.center)
s=page.step(name="Preview",start="after-previous",hold=0s)
s.animate(item)
