page=canvas(size=(100mm,65mm),stylesheet=["@laymesh/bootstrap.css","@laymesh/animate.css"],background="#f6f7fb")
card=page.add(rect(size=(40mm,25mm),class="bg-primary rounded shadow"),anchor=center,target=page.center)
s=page.step(name="Styled entrance",start="after-previous",hold=1s)
s.animate(card,class="animate__animated animate__fadeInUp",duration=800ms)
