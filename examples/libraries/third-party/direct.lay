page=canvas(size=(140mm,80mm),stylesheet=["vendor/milligram.css","palette.css"],background="#f6f7fb")
items=[]
for appearance,label in [("button","Milligram filled"),("button button-outline","Milligram outlined")] {
 target=page.top_left
 gap=(15mm,20mm)
 if len(items)>0 {target=items[len(items)-1].top_right
 gap=(25mm,0mm)}
 item=page.add(rect(size=(40mm,25mm),class=appearance),target=target,offset=gap)
 items=append(items,item)
 page.add(text(label,class="caption"),target=item.bottom_left,offset=(0mm,8mm))
}
